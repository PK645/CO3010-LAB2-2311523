void displayLEDMatrix(char c, int index)
{
    uint8_t pattern;

    // choose char
    if (c >= '0' && c <= '9')
        pattern = c - '0';
    else if (c >= 'A' && c <= 'Z')
        pattern = c - 'A' + 10;
    else
        pattern = 36; // clone char

    // input to (ROW)
    for (int i = 0; i < 8; i++) {
        uint8_t bit = (setMatrixRow[pattern][index] >> i) & 0x01;
        HAL_GPIO_WritePin(ROW_Port[i], ROW_Pin[i], bit ? GPIO_PIN_SET : GPIO_PIN_RESET);
    }
}

void updateLEDMatrix(int index)
{
    for (int i = 0; i < 8; i++) {
        HAL_GPIO_WritePin(ENM_Port[i], ENM_Pin[i], GPIO_PIN_SET);
    }

    if (index >= 0 && index < 8) {
        HAL_GPIO_WritePin(ENM_Port[index], ENM_Pin[index], GPIO_PIN_RESET);
    }
}

